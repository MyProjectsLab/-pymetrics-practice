{
  "name": "assessment-practice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-analytics.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "forms:check": "node scripts/generate-stop-forms.mjs --check",
    "forms:v13:check": "node scripts/generate-stop-forms-v13.mjs --check",
    "drills:check": "node scripts/generate-stop-drills.mjs --check",
    "balloons:check": "node scripts/check-balloons-manifests.mjs && node scripts/check-balloons-drills.mjs",
    "arrows:check": "node scripts/generate-arrows-forms.mjs --check",
    "lengths:check": "node scripts/generate-lengths-forms.mjs --check",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm test && npm run forms:check && npm run forms:v13:check && npm run drills:check && npm run arrows:check && npm run lengths:check && npm run digits:check && npm run build",
    "digits:check": "node scripts/review-digits-v11-forms.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "lucide-react": "1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^27.0.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.18"
  }
}
