    { "id": "submit-at-deadline", "entryOpenedMs": 1000, "deadlineMs": 21000, "submitMs": 21000, "target": "1234", "response": "1234", "acceptedSubmit": false, "scoredExact": false },
    { "id": "submit-after-deadline", "entryOpenedMs": 1000, "deadlineMs": 21000, "submitMs": 21000.001, "target": "1234", "response": "1234", "acceptedSubmit": false, "scoredExact": false }
  ],
  "voiceEligibilityCases": [
