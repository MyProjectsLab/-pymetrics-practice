{
  "version": "digits_fixtures_v1_0",
  "classificationCases": [
    { "id": "exact", "target": "1234", "response": "1234", "expected": { "exact": true, "positionMatches": 4, "substitutions": 0, "transpositionPairs": 0, "transpositionPositions": 0, "missingSuffix": 0 } },
    { "id": "substitution", "target": "1234", "response": "1294", "expected": { "exact": false, "positionMatches": 3, "substitutions": 1, "transpositionPairs": 0, "transpositionPositions": 0, "missingSuffix": 0 } },
    { "id": "one-adjacent-swap", "target": "12345", "response": "13245", "expected": { "exact": false, "positionMatches": 3, "substitutions": 0, "transpositionPairs": 1, "transpositionPositions": 2, "missingSuffix": 0 } },
    { "id": "two-disjoint-swaps", "target": "12345", "response": "21435", "expected": { "exact": false, "positionMatches": 1, "substitutions": 0, "transpositionPairs": 2, "transpositionPositions": 4, "missingSuffix": 0 } },
    { "id": "partial-prefix", "target": "12345", "response": "123", "expected": { "exact": false, "positionMatches": 3, "substitutions": 0, "transpositionPairs": 0, "transpositionPositions": 0, "missingSuffix": 2 } },
    { "id": "empty-skip", "target": "12345", "response": "", "expected": { "exact": false, "positionMatches": 0, "substitutions": 0, "transpositionPairs": 0, "transpositionPositions": 0, "missingSuffix": 5 } },
    { "id": "repeated-response-digit", "target": "12345", "response": "11345", "expected": { "exact": false, "positionMatches": 4, "substitutions": 1, "transpositionPairs": 0, "transpositionPositions": 0, "missingSuffix": 0 } },
    { "id": "nonadjacent-reordering", "target": "12345", "response": "32145", "expected": { "exact": false, "positionMatches": 3, "substitutions": 2, "transpositionPairs": 0, "transpositionPositions": 0, "missingSuffix": 0 } }
