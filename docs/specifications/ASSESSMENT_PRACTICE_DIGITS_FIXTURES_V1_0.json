    { "id": "remote-only", "explicitVoiceURI": null, "voices": [{ "voiceURI": "a-remote", "lang": "en-US", "localService": false }], "expectedSelectedVoiceURI": null },
    { "id": "explicit-remote", "explicitVoiceURI": "a-remote", "voices": [{ "voiceURI": "a-remote", "lang": "en-US", "localService": false }, { "voiceURI": "z-local", "lang": "en-US", "localService": true }], "expectedSelectedVoiceURI": null },
    { "id": "explicit-local", "explicitVoiceURI": "z-local", "voices": [{ "voiceURI": "a-remote", "lang": "en-US", "localService": false }, { "voiceURI": "z-local", "lang": "en-US", "localService": true }], "expectedSelectedVoiceURI": "z-local" },
    { "id": "stable-local-recheck", "explicitVoiceURI": null, "voices": [{ "voiceURI": "z-local", "lang": "en-US", "localService": true }], "expectedSelectedVoiceURI": "z-local", "recheckVoices": [{ "voiceURI": "z-local", "lang": "en-US", "localService": true }], "expectedRecheckEligible": true },
    { "id": "local-becomes-remote", "explicitVoiceURI": null, "voices": [{ "voiceURI": "z-local", "lang": "en-US", "localService": true }], "expectedSelectedVoiceURI": "z-local", "recheckVoices": [{ "voiceURI": "z-local", "lang": "en-US", "localService": false }], "expectedRecheckEligible": false },
    { "id": "local-disappears", "explicitVoiceURI": null, "voices": [{ "voiceURI": "z-local", "lang": "en-US", "localService": true }], "expectedSelectedVoiceURI": "z-local", "recheckVoices": [], "expectedRecheckEligible": false },
    { "id": "same-uri-ambiguous", "explicitVoiceURI": null, "voices": [{ "voiceURI": "z-local", "lang": "en-US", "localService": true }, { "voiceURI": "z-local", "lang": "en-US", "localService": false }], "expectedSelectedVoiceURI": null }
